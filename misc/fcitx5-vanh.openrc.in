user="${RC_SVCNAME#*.}"
supervisor=supervise-daemon
respawn_delay=0
respawn_max=0

name="fcitx5-vanh-server"
description="Fcitx5 Vanh Server for $user"
# Only for the priority boost at startup; the server drops it (and every other capability) itself.
capabilities="^cap_sys_nice"
command="@CMAKE_INSTALL_FULL_BINDIR@/fcitx5-vanh-server"
command_args="-u $user"
command_user="@LOTUS_UINPUT_PROXY_USER@:input"
pidfile="/run/${RC_SVCNAME}.pid"
depend() {
    need localmount
    after udev
}

start_pre() {
   if [ "$user" = "${RC_SVCNAME}" ]; then
        eerror "$name cannot be started directly. You must create"
        eerror "symbolic links to it for the users you want to start"
        einfo "Usage:"
        einfo "     sudo ln -s /etc/init.d/fcitx5-vanh /etc/init.d/fcitx5-vanh.\$(whoami)"
        einfo "     sudo rc-service fcitx5-vanh.\$(whoami) restart"
        return 1
   fi
   # Socket directory (see tmpfiles.d/vanh.conf): the server creates /run/vanh/$user inside it.
   # Only /run/vanh is touched as root; it lives directly in root-owned /run.
   checkpath -d -o "@LOTUS_UINPUT_PROXY_USER@:root" -m 0755 /run/vanh
}

stop_post() {
    rm -f "$pidfile"
}
